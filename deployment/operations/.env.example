# Local staging values only. Never point this recipe at the production project.
SUPABASE_URL=https://STAGING-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-staging-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-credential
GRIDPULSE_ALLOWED_ORIGINS=https://approved-staging-frontend.example
GRIDPULSE_BUILD_SHA=replace-with-40-character-commit
GRIDPULSE_ENGINE_VERSION=replace-with-approved-exact-version
GRIDPULSE_ENGINE_SHA256=replace-with-approved-64-character-sha256
GRIDPULSE_CANONICAL_WHEEL=/opt/gridpulse/replace-with-original-approved-wheel-filename.whl
