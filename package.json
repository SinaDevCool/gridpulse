{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "grid:test": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m unittest discover -s services/grid-data/tests\"",
    "grid:fetch:brandenburg": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli fetch-osm --bbox 52.22,13.15,52.40,13.55 --endpoint https://overpass.kumi.systems/api/interpreter --output public/power-finder/brandenburg-osm.json\"",
    "grid:write-sql": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli write-sql --input public/power-finder/brandenburg-osm.json --output services/grid-data/releases/brandenburg-osm-load.sql\"",
    "verify:power-finder": "npm run grid:test && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "health:production": "node scripts/check-production-health.mjs",
    "verify:phase0": "npm run check:encoding && npm run typecheck && npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint:product": "eslint src/components/product src/context/AuthContext.tsx src/context/auth-context-core.ts src/context/useAuth.ts src/integrations/supabase/client.ts src/lib/assessment-model.ts src/routes/__root.tsx src/routes/index.tsx src/routes/pilot.tsx src/routes/pilot-requests.tsx src/routes/auth.tsx src/routes/portfolio.tsx src/routes/assessments.new.tsx src/routes/assessments.$id.tsx src/routes/evidence.tsx src/routes/reports.tsx src/routes/data-sources.tsx vite.config.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.108.2",
    "@svg-maps/germany": "^2.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "@tanstack/zod-adapter": "^1.167.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "^5.24.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "read-excel-file": "^5.8.8",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.61.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "supabase": "^2.109.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
